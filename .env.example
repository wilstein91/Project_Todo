# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋되지 않습니다.

# SQLite 파일 경로 (프로젝트 루트 기준 상대경로 또는 절대경로)
DATABASE_PATH=./data/todo.db

# 세션 쿠키 서명 키 (32자 이상). 반드시 직접 만들어 쓰세요.
#   npm run gen:secret
SESSION_SECRET=

# 최초 관리자 계정. npm run db:seed-admin 을 실행할 때만 쓰입니다.
# DB 에는 비밀번호가 아니라 bcrypt 해시만 저장됩니다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
